# Copy to .env for local builds. CI sets the same names as GitHub Actions
# variables (repo Settings → Secrets and variables → Actions → Variables).
# Nothing here is secret: PUBLIC_* values end up in the site's HTML.

# Base URL of the demo proxy (proxy/, a Cloudflare Worker), e.g.
# https://winenpot-demo-proxy.<account>.workers.dev  — or http://localhost:8787
# with `pnpm --dir proxy dev`. Only needed once a lab demo uses `proxy:`.
PUBLIC_DEMO_PROXY_URL=
