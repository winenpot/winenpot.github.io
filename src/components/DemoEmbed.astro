---
/**
 * The live part of one hosted demo from the `lab` collection, rendered
 * inside its LabTile panel. Kinds: huggingface | gradio | streamlit |
 * iframe | api.
 *
 * - Hosted apps load nothing until "Wake it up" (free hosts sleep; a
 *   stopwatch counts the cold start).
 * - api: a form, built from `inputs` (or a raw-JSON textarea from `sample`),
 *   posted to `url`, or to the demo proxy (PUBLIC_DEMO_PROXY_URL +
 *   /demo/<proxy>) for APIs that need a secret key. The proxy never
 *   sleeps, so those forms show straight away. The reply is shown per
 *   `output` (json | text | image), always as text or an <img>, never HTML.
 */
import type { CollectionEntry } from 'astro:content';
import { hfSpaceUrl } from '../lib/content';
import { t } from '../i18n/ui';
interface Props { demo: CollectionEntry<'lab'> }
const { demo } = Astro.props;
const d = demo.data;

const proxyBase = import.meta.env.PUBLIC_DEMO_PROXY_URL?.replace(/\/$/, '');
if (d.proxy && !proxyBase) {
  throw new Error(`lab/${demo.id}: "proxy: ${d.proxy}" needs PUBLIC_DEMO_PROXY_URL (see .env.example)`);
}
const src =
  d.kind === 'api' && d.proxy ? `${proxyBase}/demo/${d.proxy}`
  : d.kind === 'huggingface' && d.space ? hfSpaceUrl(d.space)
  : d.kind === 'streamlit' && d.url ? `${d.url}${d.url.includes('?') ? '&' : '?'}embed=true`
  : d.url ?? '';
const method = d.proxy ? 'POST' : d.method;
/** ready without waking: proxied APIs */
const live = d.kind === 'api' && !!d.proxy;
const fieldId = (name: string) => `in-${demo.id}-${name}`;
---
<div class="demo" data-title={d.title}>
  {!live && (
    <div class="demo__actions">
      <button type="button" class="btn-ghost" data-wake>{t('lab.wake')}</button>
      <span class="demo__clock" aria-live="polite"><span class="demo__clock-num">00</span><small class="kicker">s</small></span>
    </div>
  )}
  <div class="demo__stage" data-kind={d.kind} data-src={src} data-method={method} data-height={d.height} data-live={live ? '' : undefined}>
    {d.kind === 'api' && (
      <form class="demo__api" hidden={!live} data-output={d.output}>
        {d.inputs.length > 0 ? d.inputs.map((f) => (
          <div class="demo__field">
            <label class="kicker" for={fieldId(f.name)}>{f.label}</label>
            {f.type === 'textarea' ? <textarea id={fieldId(f.name)} name={f.name} rows="4">{f.default ?? ''}</textarea>
              : f.type === 'select' ? <select id={fieldId(f.name)} name={f.name}>{(f.options ?? []).map((o) => <option selected={o === String(f.default)}>{o}</option>)}</select>
              : <input id={fieldId(f.name)} name={f.name} type={f.type === 'number' ? 'number' : 'text'} value={f.default} step={f.type === 'number' ? 'any' : undefined} />}
          </div>
        )) : (
          <div class="demo__field">
            <label class="kicker" for={fieldId('raw')}>request body (JSON)</label>
            <textarea id={fieldId('raw')} rows="6" spellcheck="false" data-raw>{d.sample ?? '{}'}</textarea>
          </div>
        )}
        <button class="btn-ghost" type="submit">{t('lab.send')} →</button>
        <div class="demo__out" aria-live="polite"></div>
      </form>
    )}
  </div>
</div>

<script>
  import { t } from '../i18n/ui';

  /** Wire an api form: collect the fields, post them, show the reply. */
  function setupApi(form: HTMLFormElement, src: string, method: string) {
    const out = form.querySelector<HTMLElement>('.demo__out')!;
    const show = (node: Node | string) => {
      if (typeof node === 'string') { const pre = document.createElement('pre'); pre.textContent = node; node = pre; }
      out.replaceChildren(node);
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = form.querySelector<HTMLTextAreaElement>('[data-raw]');
      let body: string;
      if (raw) body = raw.value;
      else {
        const values: Record<string, string | number> = {};
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[name]').forEach((el) => {
          values[el.name] = el instanceof HTMLInputElement && el.type === 'number' ? Number(el.value) : el.value;
        });
        body = JSON.stringify(values);
      }
      show('…');
      try {
        const res = await fetch(src, { method, headers: { 'Content-Type': 'application/json' }, body: method === 'GET' ? undefined : body });
        const type = res.headers.get('content-type') ?? '';
        if (!res.ok) {
          const err = type.includes('json') ? (await res.json()).error : await res.text();
          return show(`Error ${res.status}: ${err || res.statusText}`);
        }
        if (form.dataset.output === 'image' && type.startsWith('image/')) {
          const img = document.createElement('img');
          img.src = URL.createObjectURL(await res.blob());
          img.alt = 'Result';
          return show(img);
        }
        const text = await res.text();
        let data: unknown;
        try { data = JSON.parse(text); } catch { return show(text); }
        const picked = data && typeof data === 'object' ? (data as { result?: unknown }).result : undefined;
        if (form.dataset.output === 'text' && picked != null) return show(String(picked));
        show(JSON.stringify(data, null, 2));
      } catch (err) {
        show(`${err}\n(Is CORS enabled for this site on the API?)`);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.demo').forEach((card) => {
    const stage = card.querySelector<HTMLElement>('.demo__stage')!;
    const { kind, src, method, height } = stage.dataset;
    const form = stage.querySelector<HTMLFormElement>('form');
    if (stage.hasAttribute('data-live') && form) { setupApi(form, src!, method!); return; }

    const btn = card.querySelector<HTMLButtonElement>('[data-wake]')!;
    const clock = card.querySelector<HTMLElement>('.demo__clock-num')!;
    btn.addEventListener('click', () => {
      btn.disabled = true; btn.textContent = t('lab.waking');
      const t0 = performance.now();
      const timer = setInterval(() => { clock.textContent = String(Math.min(99, Math.floor((performance.now() - t0) / 1000))).padStart(2, '0'); }, 250);
      const done = () => { clearInterval(timer); btn.textContent = '● live'; };
      if (kind === 'api' && form) {
        form.hidden = false;
        // ping the root so Render-style free servers start waking up
        fetch(src!, { method: 'GET', mode: 'no-cors' }).finally(done);
        setupApi(form, src!, method!);
        return;
      }
      const f = document.createElement('iframe');
      f.src = src!; f.loading = 'lazy'; f.title = card.dataset.title!;
      f.allow = 'clipboard-write; microphone; camera';
      f.style.height = `${height}px`;
      f.addEventListener('load', done);
      stage.replaceChildren(f);
    });
  });
</script>

<style>
  .demo__actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .demo__clock { display: inline-flex; align-items: baseline; gap: 4px; font-size: 1.6rem; font-variant-numeric: tabular-nums; color: var(--starlight); }
  .demo__stage :global(iframe) { width: 100%; border: 0; border-radius: var(--radius-sm); background: var(--night-1); margin-top: var(--s2); }
  .demo__api { display: grid; gap: var(--s1); margin-top: var(--s2); max-width: 70ch; }
  .demo__api button { justify-self: start; }
  .demo__field { display: grid; gap: 6px; }
  .demo__api textarea, .demo__api input, .demo__api select, .demo__out :global(pre) {
    width: 100%; background: var(--night-1); border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 12px; font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink);
  }
  .demo__api input, .demo__api select { min-height: 44px; }
  .demo__out :global(pre) { min-height: 3em; white-space: pre-wrap; margin: 0; }
  .demo__out :global(img) { max-width: 100%; border-radius: var(--radius-sm); }
</style>
