---
import { FLOATING } from '../config/figures';
/**
 * The page-wide layer of drifting math figures (behind content). No scroll
 * parallax: it used to write --scroll to :root on every scroll frame, which
 * restyled the whole document. Figures now only bob gently in place.
 */
---
<div class="floaters" aria-hidden="true">
  {FLOATING.map((f, i) => (
    <div
      class:list={['floater', { 'floater--desktop': f.mobile === false }]}
      style={`--x:${f.x}%; --y:${f.y}%; --size:${f.size}px; color:${f.tone}; --bob:${7 + (i % 4) * 1.7}s; --delay:${-i * 1.3}s;`}
      title={f.label}
    >
      <canvas data-figure={f.kind} data-size={f.size}></canvas>
    </div>
  ))}
</div>

<script>
  import { startFigures } from '../scripts/math-figures';
  const run = () => startFigures();
  // wait for Arsenica so canvas labels use it
  document.fonts?.ready ? document.fonts.ready.then(run) : run();
</script>

<style>
  .floaters { position: absolute; inset: 0; z-index: var(--z-floaters); pointer-events: none; overflow: hidden; }
  .floater {
    position: absolute;
    left: var(--x); top: var(--y);
    width: var(--size); height: var(--size);
    animation: bob var(--bob) ease-in-out var(--delay) infinite alternate;
    opacity: 0.8;
  }
  .floater canvas { width: 100%; height: 100%; }
  @keyframes bob {
    from { transform: translateY(-10px) rotate(-3deg); }
    to   { transform: translateY(12px) rotate(3deg); }
  }
  @media (max-width: 639px) {
    .floater--desktop { display: none; }
    .floater { width: calc(var(--size) * 0.6); height: calc(var(--size) * 0.6); opacity: 0.55; }
  }
</style>
