---
/**
 * The site's single "Hire me" button. It lives in the sticky nav (top-right,
 * every page), so it is never repeated elsewhere. Calm at rest: a thin static
 * gradient rim. On hover/focus the rim turns, a starlight tide rises inside
 * and the star spins. Opens the <HireDialog> (one per page, in Base layout).
 */
import { t } from '../i18n/ui';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<button type="button" class:list={['hire', cls]} data-hire-open aria-haspopup="dialog">
  <span class="hire__rim" aria-hidden="true"></span>
  <span class="hire__body" aria-hidden="true">
    <span class="hire__tide">
      <svg class="hire__wave" viewBox="0 0 240 40" preserveAspectRatio="none">
        <path d="M0 20 Q15 8 30 20 T60 20 T90 20 T120 20 T150 20 T180 20 T210 20 T240 20 V40 H0Z" />
        <path d="M0 22 Q15 32 30 22 T60 22 T90 22 T120 22 T150 22 T180 22 T210 22 T240 22 V40 H0Z" />
      </svg>
    </span>
  </span>
  <span class="hire__label">
    <svg class="hire__star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5l2.2 7.3 7.3 2.2-7.3 2.2L12 20.5l-2.2-7.3L2.5 11l7.3-2.2z"/></svg>
    {t('hire.cta')}
  </span>
</button>

<style is:global>
  @layer components {
    .hire {
      position: relative;
      isolation: isolate;
      display: inline-grid;
      place-items: center;
      height: 44px;
      padding: 0 20px;
      border: 0;
      border-radius: 999px;
      background: none;
      color: var(--pearl);
      font-family: var(--font-mono);
      font-weight: 500;
      font-size: 0.86rem;
      letter-spacing: 0.04em;
      transition: color 300ms, transform 300ms var(--ease-spring);
    }
    /* thin gradient rim: static at rest, turns only while hovered/focused */
    .hire__rim {
      position: absolute; inset: 0; border-radius: inherit; z-index: -2;
      background: conic-gradient(from var(--spin), var(--violet), var(--periwinkle), var(--starlight), var(--mauve), var(--violet));
      opacity: 0.7;
      transition: opacity 300ms;
    }
    .hire:hover .hire__rim, .hire:focus-visible .hire__rim { opacity: 1; animation: hire-spin 3s linear infinite; }
    @keyframes hire-spin { to { --spin: 360deg; } }
    .hire__body {
      position: absolute; inset: 1.5px; border-radius: inherit; z-index: -1; overflow: hidden;
      background: radial-gradient(120% 140% at 30% 0%, var(--night-3), var(--night-1));
    }
    /* the tide rises (Y) on hover; the wave inside drifts (X) only while risen.
       Both are transforms, so no layout work (the old version animated `left`). */
    .hire__tide { position: absolute; inset: 0; transform: translateY(101%); transition: transform 600ms var(--ease-out); }
    .hire__wave { position: absolute; left: 0; bottom: 0; width: 200%; height: 100%; }
    .hire__wave path:first-child { fill: color-mix(in oklab, var(--periwinkle) 55%, transparent); }
    .hire__wave path:last-child { fill: color-mix(in oklab, var(--starlight) 70%, var(--lavender)); }
    .hire:hover .hire__tide, .hire:focus-visible .hire__tide { transform: translateY(4%); }
    .hire:hover .hire__wave, .hire:focus-visible .hire__wave { animation: hire-wave 3.2s linear infinite; }
    @keyframes hire-wave { to { transform: translateX(-50%); } }
    .hire:hover, .hire:focus-visible { color: var(--night-0); }
    .hire:active { transform: scale(0.96); }
    .hire__label { position: relative; display: inline-flex; align-items: center; gap: 10px; }
    .hire__star { width: 14px; height: 14px; fill: currentColor; transition: transform 700ms var(--ease-spring); }
    .hire:hover .hire__star, .hire:focus-visible .hire__star { transform: rotate(180deg) scale(1.2); }
  }
</style>
