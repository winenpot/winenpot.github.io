---
import { NAV, SITE } from '../config/site';
import { t } from '../i18n/ui';
import HireButton from './HireButton.astro';
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href);
---
<header class="nav">
  <div class="nav__inner page">
    <a class="nav__brand" href="/" aria-label={`${SITE.name} — home`}>
      <svg class="nav__mark" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="30" />
        <path d="M32 32 a3 3 0 0 1 3 3 a6 6 0 0 1 -6 6 a9 9 0 0 1 -9 -9 a15 15 0 0 1 15 -15 a24 24 0 0 1 24 24" />
      </svg>
      <span class="nav__name">{SITE.firstName} <em>{SITE.lastName}</em></span>
    </a>
    <nav class="nav__links" aria-label="Main">
      {NAV.map((n) => (
        <a href={n.href} class:list={{ 'is-active': active(n.href) }} aria-current={active(n.href) ? 'page' : undefined}>
          <span class:list={{ 'wave-underline': active(n.href) }}>{t(n.key)}</span>
        </a>
      ))}
    </nav>
    <HireButton size="sm" class="nav__hire" />
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: var(--z-nav); padding-block: 12px; }
  .nav::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to bottom, rgb(10 11 28 / 0.85), rgb(10 11 28 / 0.4) 70%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    -webkit-mask: linear-gradient(to bottom, #000 70%, transparent); mask: linear-gradient(to bottom, #000 70%, transparent);
  }
  .nav__inner { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'brand hire' 'links links'; align-items: center; gap: 8px 16px; }
  @media (min-width: 900px) { .nav__inner { grid-template-columns: auto 1fr auto; grid-template-areas: 'brand links hire'; } }
  .nav__brand { grid-area: brand; display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--pearl); min-height: 44px; }
  .nav__mark { width: 34px; height: 34px; fill: none; stroke: var(--starlight); stroke-width: 2.2; stroke-linecap: round; transition: transform 900ms var(--ease-spring); }
  .nav__mark circle { stroke: var(--lavender); stroke-width: 1.6; opacity: 0.6; }
  .nav__brand:hover .nav__mark { transform: rotate(-137.5deg); }
  .nav__name { font-family: var(--font-display); font-size: 1.25rem; font-variation-settings: 'opsz' 72, 'SOFT' 100; letter-spacing: -0.01em; }
  .nav__name em { font-weight: 300; color: var(--lavender); }
  .nav__links { grid-area: links; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; justify-content: flex-start; -webkit-mask: linear-gradient(to right, #000 85%, transparent); mask: linear-gradient(to right, #000 85%, transparent); }
  @media (min-width: 900px) { .nav__links { justify-content: center; -webkit-mask: none; mask: none; } }
  .nav__links a {
    font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-soft); text-decoration: none;
    padding: 10px 14px; border-radius: 999px; white-space: nowrap; transition: color 200ms, background 200ms;
  }
  .nav__links a:hover { color: var(--pearl); background: color-mix(in oklab, var(--lavender) 12%, transparent); }
  .nav__links a.is-active { color: var(--starlight); }
  :global(.nav__hire) { grid-area: hire; justify-self: end; }
</style>
