---
/** Margin notes from mathematicians and philosophers, cross-fading. */
const quotes = [
  { q: 'Mathematics is the art of giving the same name to different things.', a: 'Henri Poincaré' },
  { q: 'Wir müssen wissen — wir werden wissen.', a: 'David Hilbert' },
  { q: 'All things excellent are as difficult as they are rare.', a: 'Baruch Spinoza' },
  { q: 'Be happy for this moment. This moment is your life.', a: 'Omar Khayyam' },
  { q: 'The essence of mathematics lies in its freedom.', a: 'Georg Cantor' },
  { q: 'Geometry is knowledge of the eternally existent.', a: 'Plato' },
  { q: 'An equation for me has no meaning unless it expresses a thought of God.', a: 'Srinivasa Ramanujan' },
];
---
<div class="quotes" data-quotes>
  {quotes.map((x, i) => (
    <blockquote class:list={['quote', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
      <p>“{x.q}”</p>
      <cite class="kicker">— {x.a}</cite>
    </blockquote>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-quotes]').forEach((box) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const qs = [...box.querySelectorAll<HTMLElement>('.quote')];
    let i = 0;
    setInterval(() => {
      qs[i].classList.remove('is-on'); qs[i].setAttribute('aria-hidden', 'true');
      i = (i + 1) % qs.length;
      qs[i].classList.add('is-on'); qs[i].removeAttribute('aria-hidden');
    }, 7500);
  });
</script>

<style>
  .quotes { display: grid; flex: 1; }
  .quote { grid-area: 1 / 1; opacity: 0; transform: translateY(8px); filter: blur(4px); transition: opacity 900ms var(--ease-out), transform 900ms var(--ease-out), filter 900ms; display: flex; flex-direction: column; justify-content: center; gap: var(--s1); }
  .quote.is-on { opacity: 1; transform: none; filter: none; }
  .quote p { font-size: var(--step-1); font-style: italic; font-weight: 300; line-height: 1.35; color: var(--pearl); }
</style>
