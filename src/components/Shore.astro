---
/**
 * The page's floor: a painted wave-sea (Higgsfield) with a 1940s
 * mathematician sitting on a stone in the bottom-left corner. He writes;
 * every so often he looks up at the stars (two painted poses cross-fade)
 * and a shooting star answers. Hovering him makes him look up too.
 * Swap the art: src/assets/art/mathematician-{down,up}.png (same canvas
 * size, transparent background, only the head should differ).
 */
import { Image } from 'astro:assets';
import shore from '../assets/art/sky-shore.png';
import mDown from '../assets/art/mathematician-down.png';
import mUp from '../assets/art/mathematician-up.png';
import { SITE, NAV } from '../config/site';
import { t } from '../i18n/ui';
const year = new Date().getFullYear();
---
<footer class="shore">
  <Image src={shore} alt="" widths={[960, 1600, 2048]} sizes="100vw" class="shore__sea" aria-hidden="true" />
  <div class="shore__thinker" id="thinker" role="img" aria-label="A painted 1940s mathematician sitting on a stone, writing equations and now and then looking up at the stars">
    <Image src={mDown} alt="" widths={[260, 420, 640]} sizes="(max-width: 640px) 170px, 290px" class="k k--down" />
    <Image src={mUp} alt="" widths={[260, 420, 640]} sizes="(max-width: 640px) 170px, 290px" class="k k--up" />
  </div>

  <div class="shore__inner page">
    <blockquote class="shore__quote">
      <p>“Ah, but my Computations, People say,<br />Reduced the Year to better reckoning? — Nay,<br />’Twas only striking from the Calendar<br />Unborn To-morrow, and dead Yesterday.”</p>
      <cite class="kicker">Omar Khayyam · Rubáiyát, LVII (tr. FitzGerald)</cite>
    </blockquote>

    <nav class="shore__nav" aria-label="Footer">
      <a href="/">{t('nav.home')}</a>
      {NAV.map((n) => <a href={n.href}>{t(n.key)}</a>)}
      <a href="/resume/">Résumé</a>
    </nav>
    <ul class="shore__links" role="list">
      {SITE.links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
    </ul>
    <p class="kicker shore__fine">© {year} {SITE.name} · {t('footer.built')}</p>
  </div>
</footer>

<script>
  const k = document.getElementById('thinker');
  if (k && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cycle = () => {
      setTimeout(() => {
        k.classList.add('is-looking');
        setTimeout(() => dispatchEvent(new CustomEvent('thinker:lookup')), 700);
        setTimeout(() => { k.classList.remove('is-looking'); cycle(); }, 4200 + Math.random() * 1500);
      }, 7000 + Math.random() * 8000);
    };
    cycle();
    k.addEventListener('pointerenter', () => { k.classList.add('is-looking'); dispatchEvent(new CustomEvent('thinker:lookup')); });
    k.addEventListener('pointerleave', () => k.classList.remove('is-looking'));
  }
</script>

<style>
  .shore {
    position: relative; z-index: var(--z-content);
    margin-top: var(--s6);
    min-height: 560px;
    display: flex; align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .shore__sea {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; z-index: -2;
    -webkit-mask: linear-gradient(to bottom, transparent, #000 32%);
            mask: linear-gradient(to bottom, transparent, #000 32%);
    opacity: 0.95;
  }
  .shore::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to bottom, transparent 40%, rgb(10 11 28 / 0.55)); }

  .shore__thinker {
    position: absolute; left: clamp(-10px, 1vw, 24px); bottom: 0;
    width: clamp(160px, 21vw, 290px); aspect-ratio: 900 / 1266;
    z-index: 1; pointer-events: auto;
    filter: drop-shadow(0 0 1.5px rgb(191 176 234 / 0.55)) drop-shadow(-6px -4px 18px rgb(154 166 236 / 0.25)) drop-shadow(0 14px 30px rgb(0 0 0 / 0.55));
    animation: breathe 5.5s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .k { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: bottom; transition: opacity 1.1s var(--ease-out); }
  .k--up { opacity: 0; }
  .is-looking .k--up { opacity: 1; }
  .is-looking .k--down { opacity: 0; }
  @keyframes breathe { 50% { transform: scaleY(1.008); } }

  .shore__inner {
    display: grid; gap: var(--s2);
    padding-block: var(--s6) var(--s3);
    padding-left: clamp(150px, 24vw, 330px);
  }
  @media (max-width: 639px) { .shore__inner { padding-left: 0; padding-bottom: calc(var(--s3) + 210px); } .shore { min-height: 640px; } }
  .shore__quote p { font-style: italic; font-weight: 300; font-size: var(--step-1); line-height: 1.45; color: var(--pearl); max-width: 32ch; text-shadow: 0 2px 16px rgb(10 11 28 / 0.8); }
  .shore__quote cite { display: block; margin-top: var(--s1); font-style: normal; }
  .shore__nav, .shore__links { display: flex; flex-wrap: wrap; gap: 6px 20px; font-family: var(--font-mono); font-size: 0.9rem; }
  .shore__links { list-style: none; padding: 0; }
  .shore__nav a, .shore__links a { color: var(--ink); text-decoration: none; padding-block: 10px; }
  .shore__nav a:hover, .shore__links a:hover { color: var(--starlight); }
  .shore__fine { font-size: 0.75rem; }
</style>
