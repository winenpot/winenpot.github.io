---
/**
 * The fixed backdrop: a painted symbolist sky (Higgsfield, Ciurlionis x
 * Feininger) under a living star field. Stars twinkle, link into
 * constellations near the pointer (a little graph theory), and a shooting
 * star crosses now and then — always when the mathematician looks up.
 */
import { Image } from 'astro:assets';
import skyTop from '../assets/art/sky-top.png';
---
<div class="sky" aria-hidden="true">
  <Image src={skyTop} alt="" widths={[960, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" class="sky__paint" />
  <div class="sky__veil"></div>
  <canvas id="stars" class="sky__stars"></canvas>
</div>

<script>
  const c = document.getElementById('stars') as HTMLCanvasElement;
  const ctx = c.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Star = { x: number; y: number; r: number; p: number; s: number; tw: boolean };
  const frameInterval = 1000 / 30;
  let W = 0, H = 0, dpr = 1, stars: Star[] = [];
  // the static field is painted once to this offscreen canvas and blitted
  // every frame — only ~1 in 9 stars (tw) are redrawn live, to twinkle.
  const off = document.createElement('canvas');
  const octx = off.getContext('2d')!;
  const mouse = { x: -999, y: -999 };
  const meteors: { x: number; y: number; vx: number; vy: number; life: number }[] = [];

  function paintBase() {
    octx.clearRect(0, 0, W, H);
    for (const s of stars) {
      octx.globalAlpha = 0.62;
      octx.fillStyle = s.r > 1.5 ? '#f4e9c8' : '#e6e2fb';
      octx.beginPath(); octx.arc(s.x, s.y, s.r, 0, Math.PI * 2); octx.fill();
      if (s.r > 1.5) { octx.globalAlpha = 0.15; octx.beginPath(); octx.arc(s.x, s.y, s.r * 3.2, 0, Math.PI * 2); octx.fill(); }
    }
    octx.globalAlpha = 1;
  }
  function resize() {
    dpr = Math.min(1.5, devicePixelRatio || 1);
    W = innerWidth; H = innerHeight;
    c.width = off.width = W * dpr; c.height = off.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); octx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round((W * H) / 7000);
    stars = Array.from({ length: n }, (_, i) => ({
      x: Math.random() * W, y: Math.random() * H * 0.95,
      r: Math.random() < 0.08 ? 1.6 + Math.random() : 0.4 + Math.random() * 0.9,
      p: Math.random() * Math.PI * 2, s: 0.4 + Math.random() * 1.4,
      tw: i % 9 === 0,
    }));
    paintBase();
  }
  function shoot() {
    const fromLeft = Math.random() < 0.5;
    meteors.push({ x: fromLeft ? W * (0.1 + Math.random() * 0.4) : W * (0.5 + Math.random() * 0.4), y: H * (0.04 + Math.random() * 0.25), vx: (fromLeft ? 1 : -1) * (520 + Math.random() * 260), vy: 170 + Math.random() * 120, life: 1 });
  }
  let last = 0, lastFrame = frameInterval / 2;
  function frame(ms: number) {
    if (!reduce && ms - lastFrame < frameInterval) {
      requestAnimationFrame(frame);
      return;
    }
    lastFrame = ms;
    const t = ms / 1000, dt = Math.min(0.05, t - last); last = t;
    ctx.clearRect(0, 0, W, H);
    // the whole static field in one blit, instead of ~200 arc()+fill() calls
    ctx.save(); ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.drawImage(off, 0, 0); ctx.restore();
    for (const s of stars) {
      if (!s.tw) continue;
      const a = reduce ? 0.7 : 0.45 + 0.55 * Math.sin(t * s.s + s.p) ** 2;
      ctx.globalAlpha = a;
      ctx.fillStyle = s.r > 1.5 ? '#f4e9c8' : '#e6e2fb';
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2); ctx.fill();
    }
    // constellations: stars near the pointer link to their two nearest neighbours
    const near = stars.filter((s) => (s.x - mouse.x) ** 2 + (s.y - mouse.y) ** 2 < 150 ** 2);
    ctx.strokeStyle = '#bfb0ea'; ctx.lineWidth = 0.7;
    for (const s of near) {
      const nb = near.filter((o) => o !== s).sort((a, b) => (a.x - s.x) ** 2 + (a.y - s.y) ** 2 - ((b.x - s.x) ** 2 + (b.y - s.y) ** 2)).slice(0, 2);
      for (const o of nb) {
        const d = Math.hypot(s.x - mouse.x, s.y - mouse.y);
        ctx.globalAlpha = 0.5 * (1 - d / 150);
        ctx.beginPath(); ctx.moveTo(s.x, s.y); ctx.lineTo(o.x, o.y); ctx.stroke();
      }
    }
    for (let i = meteors.length - 1; i >= 0; i--) {
      const m = meteors[i];
      m.x += m.vx * dt; m.y += m.vy * dt; m.life -= dt * 0.9;
      const g = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * 0.22, m.y - m.vy * 0.22);
      g.addColorStop(0, 'rgba(244,233,200,0.95)'); g.addColorStop(1, 'rgba(244,233,200,0)');
      ctx.globalAlpha = Math.max(0, m.life); ctx.strokeStyle = g; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(m.x, m.y); ctx.lineTo(m.x - m.vx * 0.22, m.y - m.vy * 0.22); ctx.stroke();
      if (m.life <= 0) meteors.splice(i, 1);
    }
    ctx.globalAlpha = 1;
    if (!reduce) requestAnimationFrame(frame);
  }
  resize();
  addEventListener('resize', resize);
  addEventListener('pointermove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
  document.addEventListener('pointerleave', () => { mouse.x = mouse.y = -999; });
  addEventListener('thinker:lookup', () => shoot());
  if (!reduce) {
    const schedule = () => setTimeout(() => { if (!document.hidden) shoot(); schedule(); }, 9000 + Math.random() * 9000);
    schedule();
  }
  requestAnimationFrame(frame);
</script>

<style>
  .sky { position: fixed; inset: 0; z-index: var(--z-sky); pointer-events: none; }
  .sky__paint { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 30%; opacity: 1; }
  .sky__veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 80% at 50% 0%, transparent 40%, rgb(10 11 28 / 0.45) 100%),
      linear-gradient(to bottom, rgb(10 11 28 / 0.05), rgb(10 11 28 / 0.3) 60%, rgb(10 11 28 / 0.55));
  }
  .sky__stars { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
