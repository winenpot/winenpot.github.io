---
/**
 * Career as a wave: roles sit on a slow sine curve from the first start
 * date to today. Fed by the `work` collection. Stacks into a list on phones.
 */
import { fmtMonth, type Work } from '../lib/content';
interface Props { items: Work[] }
const { items } = Astro.props;
const asc = [...items].sort((a, b) => a.data.start.localeCompare(b.data.start));
const toN = (ym: string) => { const [y, m] = ym.split('-').map(Number); return y + (m - 1) / 12; };
const now = new Date();
const n0 = Math.floor(toN(asc[0]?.data.start ?? '2020-01')), n1 = now.getFullYear() + now.getMonth() / 12 + 0.25;
const X = (ym: string) => ((toN(ym) - n0) / (n1 - n0)) * 100;
const Y = (x: number) => 50 + 26 * Math.sin((x / 100) * Math.PI * 3.2 + 0.4);
const path = Array.from({ length: 101 }, (_, i) => `${i ? 'L' : 'M'}${i * 10} ${(Y(i) * 1.6).toFixed(2)}`).join(' ');
const years = Array.from({ length: Math.ceil(n1) - n0 }, (_, i) => n0 + i);
---
<div class="tl">
  <div class="tl__wave" aria-hidden="true">
    <svg viewBox="0 0 1000 160" preserveAspectRatio="none">
      <path d={path} class="tl__path" />
      <path d={path} class="tl__path tl__path--glow" />
    </svg>
    {years.map((y) => <span class="tl__year" style={`left:${((y - n0) / (n1 - n0)) * 100}%`}>{y}</span>)}
  </div>
  <ol class="tl__items" role="list">
    {asc.map((w, i) => {
      const x = X(w.data.start);
      return (
        <li class:list={['tl__item', i % 2 ? 'is-below' : 'is-above']} style={`--x:${x}%; --y:${Y(x)}%`}>
          <a href={`/work/${w.id}/`}>
            <span class="tl__dot" aria-hidden="true"></span>
            <span class="tl__label">
              <b>{w.data.org}</b>
              <span>{w.data.role}</span>
              <time class="kicker">{fmtMonth(w.data.start)}</time>
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .tl { position: relative; }
  .tl__wave { display: none; }
  .tl__items { display: grid; gap: 10px; list-style: none; padding: 0; }
  .tl__item a { display: flex; gap: 12px; align-items: baseline; color: var(--ink); text-decoration: none; padding: 6px 0; }
  .tl__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--starlight); box-shadow: 0 0 12px var(--starlight); flex: none; }
  .tl__label { display: flex; flex-wrap: wrap; gap: 2px 10px; align-items: baseline; }
  .tl__label b { font-weight: 500; color: var(--pearl); }
  .tl__label span { color: var(--ink-soft); font-size: 0.95rem; }

  @media (min-width: 900px) {
    .tl { height: 250px; margin-top: var(--s1); }
    .tl__wave { display: block; position: absolute; inset: 0; }
    .tl__wave svg { width: 100%; height: 100%; overflow: visible; }
    .tl__path { fill: none; stroke: var(--periwinkle); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-dasharray: 6 6; animation: flow 6s linear infinite; }
    .tl__path--glow { stroke: var(--lavender); stroke-dasharray: none; opacity: 0.18; stroke-width: 6; filter: blur(3px); animation: none; }
    @keyframes flow { to { stroke-dashoffset: -120; } }
    .tl__year { position: absolute; bottom: -6px; transform: translateX(-50%); font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-mute); }
    .tl__items { position: absolute; inset: 0; display: block; }
    .tl__item { position: absolute; left: var(--x); top: var(--y); }
    .tl__item a { position: relative; display: block; padding: 0; }
    .tl__dot { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; transition: transform 400ms var(--ease-spring); }
    .tl__item a:hover .tl__dot, .tl__item a:focus-visible .tl__dot { transform: scale(1.5); }
    .tl__label { position: absolute; left: -8px; width: max-content; max-width: 170px; display: grid; gap: 0; font-size: 0.85rem; line-height: 1.3; }
    .is-above .tl__label { bottom: 16px; }
    .is-below .tl__label { top: 16px; }
    .tl__label span { font-size: 0.8rem; }
    .tl__item:last-child .tl__label, .tl__item:nth-last-child(2) .tl__label { left: auto; right: -8px; text-align: right; }
  }
</style>
