---
/**
 * Career as a wave: numbered stars sit on a slow sine curve from the first
 * start date to today; a legend below names each one. Hovering either
 * lights up its twin. Fed by the `work` collection. On phones only the
 * legend shows.
 */
import { fmtMonth, type Work } from '../lib/content';
interface Props { items: Work[] }
const { items } = Astro.props;
const asc = [...items].sort((a, b) => a.data.start.localeCompare(b.data.start));
const toN = (ym: string) => { const [y, m] = ym.split('-').map(Number); return y + (m - 1) / 12; };
const now = new Date();
const n0 = Math.floor(toN(asc[0]?.data.start ?? '2020-01')), n1 = now.getFullYear() + now.getMonth() / 12 + 0.25;
const X = (ym: string) => 2 + ((toN(ym) - n0) / (n1 - n0)) * 96;
const Y = (x: number) => 50 + 30 * Math.sin((x / 100) * Math.PI * 3.2 + 0.4);
const path = Array.from({ length: 101 }, (_, i) => `${i ? 'L' : 'M'}${i * 10} ${Y(i).toFixed(2)}`).join(' ');
const years = Array.from({ length: Math.ceil(n1) - n0 }, (_, i) => n0 + i);
---
<div class="tl" data-tl>
  <div class="tl__wave" aria-hidden="true">
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none">
      <path d={path} class="tl__glow" />
      <path d={path} class="tl__path" />
    </svg>
    {years.map((y) => <span class="tl__year" style={`left:${2 + ((y - n0) / (n1 - n0)) * 96}%`}>{y}</span>)}
    {asc.map((w, i) => {
      const x = X(w.data.start);
      return <a class="tl__dot" href={`/work/${w.id}/`} tabindex="-1" data-i={i} style={`left:${x}%; top:${Y(x)}%`}>{i + 1}</a>;
    })}
  </div>
  <ol class="tl__legend" role="list">
    {asc.map((w, i) => (
      <li data-i={i}>
        <a href={`/work/${w.id}/`}>
          <span class="tl__n" aria-hidden="true">{i + 1}</span>
          <span class="tl__text">
            <b>{w.data.org}</b>
            <span>{w.data.role}</span>
            <time class="kicker">{fmtMonth(w.data.start)}</time>
          </span>
        </a>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tl]').forEach((tl) => {
    const all = tl.querySelectorAll<HTMLElement>('[data-i]');
    const set = (i: string | null) => all.forEach((el) => el.classList.toggle('is-hot', el.dataset.i === i));
    all.forEach((el) => {
      el.addEventListener('pointerenter', () => set(el.dataset.i!));
      el.addEventListener('pointerleave', () => set(null));
      el.addEventListener('focusin', () => set(el.dataset.i!));
      el.addEventListener('focusout', () => set(null));
    });
  });
</script>

<style>
  .tl { display: grid; gap: var(--s4); }
  .tl__wave { display: none; }
  .tl__legend { list-style: none; padding: 0; display: grid; gap: 4px var(--s2); grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
  .tl__legend a { display: flex; gap: 12px; align-items: flex-start; padding: 8px; margin: -8px 0 0 -8px; border-radius: 12px; color: var(--ink); text-decoration: none; transition: background 250ms; }
  .tl__legend .is-hot a, .tl__legend a:hover { background: color-mix(in oklab, var(--periwinkle) 14%, transparent); }
  .tl__n, .tl__dot {
    flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500;
    background: var(--starlight); color: var(--night-0); box-shadow: 0 0 14px color-mix(in oklab, var(--starlight) 70%, transparent);
  }
  .tl__text { display: grid; line-height: 1.3; }
  .tl__text b { font-weight: 500; color: var(--pearl); }
  .tl__text span { color: var(--ink-soft); font-size: 0.88rem; }
  .tl__text time { font-size: 0.72rem; }

  @media (min-width: 900px) {
    .tl__wave { display: block; position: relative; height: 150px; }
    .tl__wave svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .tl__path { fill: none; stroke: var(--periwinkle); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-dasharray: 6 6; }
    .tl__glow { fill: none; stroke: var(--lavender); stroke-width: 8; vector-effect: non-scaling-stroke; opacity: 0.12; }
    .tl__year { position: absolute; bottom: -22px; transform: translateX(-50%); font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-mute); }
    .tl__dot { position: absolute; translate: -50% -50%; text-decoration: none; transition: transform 400ms var(--ease-spring); }
    .tl__dot.is-hot, .tl__dot:hover { transform: scale(1.35); color: var(--night-0); }
  }
</style>
