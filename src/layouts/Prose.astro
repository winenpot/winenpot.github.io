---
/** Reading layout shared by writing, journal and work detail pages. */
import { t } from '../i18n/ui';
interface Link { href: string; label: string }
interface Props { kicker?: string; title: string; lede?: string; tags?: string[]; sample?: boolean; back: Link; prev?: Link; next?: Link }
const { kicker, title, lede, tags = [], sample, back, prev, next } = Astro.props;
---
<article class="article">
  <a class="article__back kicker" href={back.href}>← {back.label}</a>
  <header class="article__head">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lede && <p class="article__lede">{lede}</p>}
    {tags.length > 0 && <ul class="chips" role="list">{tags.map((x) => <li class="chip">#{x}</li>)}</ul>}
    {sample && <p class="sample-banner">{t('post.sample')}</p>}
    <slot name="head" />
  </header>
  <div class="article__body prose">
    <slot />
  </div>
  {(prev || next) && (
    <nav class="article__nav" aria-label="More">
      {prev ? <a href={prev.href}><span class="kicker">← older</span>{prev.label}</a> : <span />}
      {next ? <a href={next.href} class="is-next"><span class="kicker">newer →</span>{next.label}</a> : <span />}
    </nav>
  )}
</article>

<style>
  .article {
    position: relative; margin: var(--s4) auto 0; max-width: 820px;
    padding: var(--s4) var(--s2);
    border-radius: var(--radius);
    background: var(--glass-strong);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 1px var(--line);
    -webkit-mask: radial-gradient(circle at 100% 0, transparent 34px, #000 34.6px);
            mask: radial-gradient(circle at 100% 0, transparent 34px, #000 34.6px);
  }
  @media (min-width: 640px) { .article { padding: var(--s5) var(--s5); } }
  .article__back { text-decoration: none; display: inline-block; padding-block: 10px; }
  .article__back:hover { color: var(--starlight); }
  .article__head { display: grid; gap: var(--s1); margin: var(--s2) 0 var(--s4); }
  .article__head h1 { font-size: var(--step-3); }
  .article__lede { font-size: var(--step-1); font-style: italic; font-weight: 300; color: var(--ink-soft); }
  .article__nav { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); margin-top: var(--s5); padding-top: var(--s3); border-top: 1px dashed var(--line); }
  .article__nav a { display: grid; gap: 4px; text-decoration: none; color: var(--pearl); }
  .article__nav .is-next { text-align: right; }
</style>
