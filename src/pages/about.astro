---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { SITE } from '../config/site';
import { getProfile, certLine } from '../lib/content';
// Everything on this page comes from src/content/profile/.
const about = await getProfile('about');
const education = await getProfile('education');
const certificates = await getProfile('certificates');
const skills = await getProfile('skills');
const interests = await getProfile('interests');
const { Content: Story } = await render(about);
const courses = education.data.items.flatMap((e) => e.courses);
---
<Base title="About" description={`About ${SITE.name} — applied mathematician, ML engineer, lover of geometry and philosophy.`}>
  <header class="page-head">
    <p class="kicker">{SITE.location}</p>
    <h1><span class="wave-underline">About</span></h1>
    <p>{about.data.lede}</p>
  </header>
  <div class="bento">
    <Card tone="periwinkle" span="m3 l4" rows={2} class="about-photo"><PhotoFrame photo={SITE.aboutPhoto} /></Card>
    <Card tone="lavender" span="m3 l8" label="the short version" class="story">
      <div class="prose"><Story /></div>
    </Card>
    {courses.length > 0 && (
      <Card tone="starlight" span="m3 l4" label="favourite courses, by grade" class="courses">
        <ul class="grades" role="list">
          {courses.map((c) => <li><span>{c.name}</span><b>{c.grade}</b></li>)}
        </ul>
      </Card>
    )}
    <Card tone="mauve" span="m3 l4" label="loves" class="loves">
      <ul class="chips" role="list">
        {interests.data.items.map((x) => <li class="chip">{x}</li>)}
      </ul>
      {about.data.values && <p class="muted">{about.data.values}</p>}
    </Card>
    {certificates.data.items.length > 0 && (
      <Card tone="cobalt" span="m6 l8" label="certificates" class="certs">
        <ul class="certs__list">{certificates.data.items.map((c) => <li>{certLine(c)}</li>)}</ul>
      </Card>
    )}
    <Card tone="cobalt" span="m6 l12" label="stack" class="stack">
      {skills.data.summary.map(({ group, items }) => (
        <div class="stack__group">
          <p class="kicker">{group}</p>
          <ul class="chips" role="list">{items.map((i) => <li class="chip">{i}</li>)}</ul>
        </div>
      ))}
    </Card>
    <Card tone="violet" span="m6 l4" class="about-hire">
      <h2>{about.data.closing}</h2>
      <a class="btn-ghost" href="/resume/">Read the résumé <span class="arr">→</span></a>
    </Card>
  </div>
</Base>

<style>
  .about-photo { padding: var(--s1); min-height: 460px; }
  .grades { list-style: none; padding: 0; display: grid; gap: 8px; }
  .grades li { display: flex; justify-content: space-between; gap: var(--s1); border-bottom: 1px dashed var(--line); padding-bottom: 6px; font-size: 0.95rem; }
  .grades b { font-family: var(--font-mono); font-weight: 500; color: var(--starlight); }
  .certs__list { columns: 2 280px; column-gap: var(--s3); padding-left: 1.1em; color: var(--ink-soft); font-size: 0.95rem; }
  .certs__list li { margin-bottom: 6px; break-inside: avoid; }
  .stack { gap: var(--s2); }
  .stack__group { display: grid; gap: 8px; }
  .about-hire { justify-content: center; gap: var(--s2); align-items: flex-start; }
  .about-hire h2 { font-size: var(--step-2); }
</style>
