---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Seg from '../components/Seg.astro';
import HireButton from '../components/HireButton.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import EquationTicker from '../components/EquationTicker.astro';
import QuoteCycler from '../components/QuoteCycler.astro';
import Timeline from '../components/Timeline.astro';
import { SITE } from '../config/site';
import { t } from '../i18n/ui';
import { getWriting, getJournal, getWork, getLab, fmtDate } from '../lib/content';

const [writing, journal, work, lab] = await Promise.all([getWriting(), getJournal(), getWork(), getLab()]);
const years = new Date().getFullYear() - SITE.sinceYear;
const latestJournal = journal[0];
---
<Base>
  <section class="bento home">
    <!-- hero -->
    <Card tone="lavender" span="m6 l8" rows={2} class="hero">
      <p class="kicker">{SITE.coords} · <b>{SITE.role}</b></p>
      <h1 class="hero__name">
        <span class="hero__first">{SITE.firstName}</span>
        <span class="hero__last">{SITE.lastName}</span>
      </h1>
      <p class="hero__tagline">{SITE.tagline}</p>
      <p class="hero__intro">{SITE.intro}</p>
      <EquationTicker />
      <div class="hero__cta">
        <HireButton />
        <a class="btn-ghost" href="/writing/">{t('home.readWriting')} <span class="arr">→</span></a>
      </div>
    </Card>

    <!-- portrait -->
    <Card tone="periwinkle" span="m6 l4" rows={2} class="portrait">
      <PhotoFrame photo={SITE.photo} />
    </Card>

    <!-- LCD stats -->
    <Card tone="starlight" span="m6 l4" label={t('home.stats')} class="stats">
      <dl class="stats__grid">
        <div><dt>{t('stat.years')}</dt><dd><Seg value={years} label={t('stat.years')} /></dd></div>
        <div><dt>{t('stat.roles')}</dt><dd><Seg value={work.length} label={t('stat.roles')} /></dd></div>
        <div><dt>{t('stat.posts')}</dt><dd><Seg value={writing.length} label={t('stat.posts')} /></dd></div>
        <div><dt>{t('stat.demos')}</dt><dd><Seg value={lab.length} label={t('stat.demos')} /></dd></div>
      </dl>
    </Card>

    <!-- latest writing -->
    <Card tone="lavender" span="m6 l5" label={t('home.latest')} href="/writing/" class="latest">
      <ol class="latest__list" role="list">
        {writing.slice(0, 3).map((p) => (
          <li>
            <time class="kicker">{fmtDate(p.data.date)}</time>
            <span class="latest__title">{p.data.title}</span>
          </li>
        ))}
      </ol>
    </Card>

    <!-- now -->
    <Card tone="mauve" span="m6 l3" label={t('home.now')} class="now">
      <ul class="now__list">
        {SITE.now.map((n) => <li>{n}</li>)}
      </ul>
    </Card>

    <!-- career wave -->
    <Card tone="periwinkle" span="m6 l8" label={t('home.work')} class="career">
      <Timeline items={work} />
      <a class="career__more btn-ghost" href="/work/">Case studies <span class="arr">→</span></a>
    </Card>

    <!-- lab -->
    <Card tone="violet" span="m6 l4" label={t('home.lab')} href="/lab/" class="labcard">
      {lab.length ? (
        <ul class="lab__list" role="list">
          {lab.slice(0, 3).map((d) => <li><span class="pulse" aria-hidden="true"></span>{d.data.title}</li>)}
        </ul>
      ) : (
        <>
          <div class="lab__slots" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="muted">{t('lab.empty')}</p>
        </>
      )}
    </Card>

    <!-- journal -->
    <Card tone="starlight" span="m3 l4" label={t('home.journal')} href="/journal/" class="journalcard">
      {latestJournal && (
        <>
          <time class="kicker">{fmtDate(latestJournal.data.date)}{latestJournal.data.mood && ` · ${latestJournal.data.mood}`}</time>
          <h3>{latestJournal.data.title}</h3>
          <p class="muted clamp">{latestJournal.body?.slice(0, 180)}…</p>
        </>
      )}
    </Card>

    <!-- quote -->
    <Card tone="lavender" span="m3 l4" label={t('home.quote')} class="quotecard">
      <QuoteCycler />
    </Card>

    <!-- toolbox -->
    <Card tone="cobalt" span="m6 l4" label={t('home.stack')} class="stack">
      {Object.entries(SITE.stack).map(([group, items]) => (
        <div class="stack__group">
          <p class="kicker">{group}</p>
          <ul class="chips" role="list">{items.map((i) => <li class="chip">{i}</li>)}</ul>
        </div>
      ))}
    </Card>

    <!-- closing call -->
    <Card tone="starlight" span="m6 l12" class="closing">
      <div>
        <h2>{SITE.hire.headline}</h2>
        <p class="muted">{SITE.hire.availability}</p>
      </div>
      <div class="closing__actions">
        <HireButton />
        <ul class="closing__links" role="list">
          {SITE.links.filter((l) => l.icon !== 'rss').map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
        </ul>
      </div>
    </Card>
  </section>
</Base>

<style>
  .home { padding-top: var(--s3); }
  .hero { justify-content: center; gap: var(--s2); padding-block: var(--s4); }
  .hero__name { font-size: var(--step-4); line-height: 0.95; display: grid; }
  .hero__first { font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; font-weight: 340; }
  .hero__last {
    font-style: italic; font-weight: 250; padding-left: 0.6em;
    background: linear-gradient(100deg, var(--lavender), var(--periwinkle) 40%, var(--starlight) 60%, var(--mauve));
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: sheen 9s ease-in-out infinite alternate;
  }
  @keyframes sheen { to { background-position: 100% 0; } }
  .hero__tagline { font-size: var(--step-1); font-weight: 300; font-style: italic; color: var(--pearl); max-width: 34ch; }
  .hero__intro { color: var(--ink-soft); max-width: 58ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: var(--s1); }

  .portrait { padding: var(--s1); min-height: 420px; }
  .portrait :global(.arch) { flex: 1; }

  .stats__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2) var(--s1); }
  .stats__grid div { display: grid; gap: 6px; }
  .stats__grid dt { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-mute); order: 2; }
  .stats__grid dd { margin: 0; font-size: 2.6rem; order: 1; }

  .latest__list { display: grid; gap: var(--s1); padding: 0; }
  .latest__list li { display: grid; gap: 2px; padding-bottom: var(--s1); border-bottom: 1px dashed var(--line); }
  .latest__list li:last-child { border: 0; }
  .latest__title { font-size: var(--step-1); line-height: 1.25; color: var(--pearl); }

  .now__list { padding-left: 1.1em; display: grid; gap: 10px; color: var(--ink-soft); font-size: 0.98rem; }
  .now__list li::marker { content: '✦  '; color: var(--mauve); }

  .career { gap: var(--s2); }
  .career__more { align-self: flex-start; margin-top: var(--s2); }

  .lab__slots { display: flex; gap: 8px; }
  .lab__slots span { flex: 1; height: 54px; border-radius: 12px; border: 1px dashed var(--line-strong); position: relative; overflow: hidden; }
  .lab__slots span::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--violet) 30%, transparent), transparent); transform: translateX(-100%); animation: scan 2.8s var(--ease-out) infinite; }
  .lab__slots span:nth-child(2)::after { animation-delay: 0.4s; } .lab__slots span:nth-child(3)::after { animation-delay: 0.8s; }
  @keyframes scan { to { transform: translateX(100%); } }
  .lab__list { display: grid; gap: 8px; padding: 0; }
  .lab__list li { display: flex; gap: 10px; align-items: center; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #8ef0c0; box-shadow: 0 0 0 0 #8ef0c066; animation: pulse 2s infinite; }
  @keyframes pulse { to { box-shadow: 0 0 0 10px #8ef0c000; } }

  .journalcard h3 { font-size: var(--step-1); }
  .clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .quotecard { min-height: 240px; }

  .stack { gap: var(--s2); }
  .stack__group { display: grid; gap: 8px; }

  .closing { flex-direction: column; gap: var(--s3); padding-block: var(--s4); }
  @media (min-width: 900px) { .closing { flex-direction: row; justify-content: space-between; align-items: center; } }
  .closing h2 { font-size: var(--step-3); }
  .closing__actions { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; }
  .closing__links { display: flex; gap: 16px; font-family: var(--font-mono); font-size: 0.9rem; padding: 0; }
  .closing__links a { color: var(--ink); text-decoration: none; padding-block: 12px; }
  .closing__links a:hover { color: var(--starlight); }
</style>
