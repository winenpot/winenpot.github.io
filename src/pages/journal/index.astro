---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getJournal, fmtDate } from '../../lib/content';
const entries = await getJournal();
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---
<Base title="Journal" description="Short dated notes — thoughts, small wins, questions.">
  <header class="page-head">
    <p class="kicker">notes · {entries.length}</p>
    <h1><span class="wave-underline">Journal</span></h1>
    <p>Short, dated, a little more personal. Written at night, mostly.</p>
  </header>
  <ol class="journal" role="list">
    {rendered.map(({ e, Content }) => (
      <li class="entry" id={e.id}>
        <div class="entry__date" aria-hidden="true">
          <span class="entry__day">{e.data.date.getUTCDate().toString().padStart(2, '0')}</span>
          <span class="kicker">{fmtDate(e.data.date, { month: 'short', year: 'numeric' })}</span>
        </div>
        <article class="entry__card">
          <p class="kicker">{fmtDate(e.data.date)}{e.data.mood && ` · feeling ${e.data.mood}`}</p>
          <h2><a href={`/journal/${e.id}/`}>{e.data.title}</a></h2>
          {e.data.sample && <span class="sample-banner">sample</span>}
          <div class="prose"><Content /></div>
        </article>
      </li>
    ))}
  </ol>
</Base>

<style>
  .journal { list-style: none; padding: 0; display: grid; gap: var(--s3); position: relative; max-width: 860px; }
  .journal::before { content: ''; position: absolute; left: 34px; top: 0; bottom: 0; width: 1px; background: linear-gradient(var(--starlight), transparent); opacity: 0.4; }
  .entry { display: grid; grid-template-columns: 70px 1fr; gap: var(--s2); }
  .entry__date { display: grid; justify-items: center; align-content: start; gap: 2px; position: relative; z-index: 1; padding-top: var(--s2); }
  .entry__day { font-family: var(--font-display); font-size: 2.2rem; font-style: italic; color: var(--starlight); line-height: 1; background: var(--night-0); border-radius: 50%; width: 56px; height: 56px; display: grid; place-items: center; box-shadow: 0 0 0 1px var(--line-strong); }
  .entry__card {
    padding: var(--s3); border-radius: var(--radius); background: var(--glass); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px var(--line);
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, color-mix(in oklab, var(--lavender) 9%, transparent) 31px 32px);
    display: grid; gap: var(--s1);
  }
  .entry__card h2 { font-size: var(--step-2); }
  .entry__card h2 a { color: var(--pearl); text-decoration: none; }
  .entry__card h2 a:hover { color: var(--starlight); }
</style>
