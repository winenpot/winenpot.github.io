---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import ExpandGrid from '../../components/ExpandGrid.astro';
import LabTile from '../../components/LabTile.astro';
import DemoEmbed from '../../components/DemoEmbed.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getLab, labPageUrl, isTemplate, topTags } from '../../lib/content';
import { t } from '../../i18n/ui';
const demos = await getLab();
const live = demos.filter((d) => !isTemplate(d)).length;

/** kind: native — every file in src/components/demos/ registers itself under
 *  its file name, so `component: TSpanner` renders demos/TSpanner.astro.
 *  Its logic (demos/TSpanner.ts, if any) loads only when the tile opens. */
const NATIVE = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: any }>('../../components/demos/*.astro', { eager: true }))
    .map(([path, mod]) => [path.split('/').pop()!.replace(/\.astro$/, ''), mod.default]),
);
for (const d of demos) {
  if (d.data.kind === 'native' && !NATIVE[d.data.component ?? '']) {
    throw new Error(`lab/${d.id}: component "${d.data.component}" not found in src/components/demos/ (have: ${Object.keys(NATIVE).join(', ')})`);
  }
}
---
<Base title="Lab" description="Live experiments: Hugging Face Spaces, Gradio, Streamlit and APIs, running right on the page.">
  <header class="page-head">
    <p class="kicker">live experiments · {live}</p>
    <h1><span class="wave-underline">Lab</span></h1>
    <p>Things you can poke. Pick a tile to open it — hosted demos need a “wake it up” and a few seconds for a sleepy free server.</p>
  </header>
  <TagFilter tags={topTags(demos.map((d) => d.data.tags))} target=".xtile" />
  {demos.length ? (
    <ExpandGrid>
      {demos.map((d) => {
        const Native = d.data.kind === 'native' ? NATIVE[d.data.component!] : undefined;
        return (
          <LabTile demo={d} page={labPageUrl(d.data)}>
            {Native ? <Native demo={d} /> : <DemoEmbed demo={d} />}
          </LabTile>
        );
      })}
    </ExpandGrid>
  ) : (
    <div class="bento">
      <Card tone="violet" span="m6 l12" label="workbench" class="empty">
        <div class="empty__slots" aria-hidden="true">
          {['huggingface', 'gradio', 'streamlit', 'api'].map((k) => <span><i></i>{k}</span>)}
        </div>
        <p class="empty__text">{t('lab.empty')}</p>
      </Card>
    </div>
  )}
</Base>

<script>
  /**
   * Native demos ship as markup (demos/<Name>.astro, root [data-demo="<Name>"])
   * plus optional logic (demos/<Name>.ts, `export function mount(root)`).
   * The glob is lazy, so Vite emits one chunk per demo and the page only
   * downloads a demo's code the first time its tile opens. With 100 demos,
   * /lab still loads none of them.
   */
  const loaders = import.meta.glob<{ mount: (root: HTMLElement) => void }>('../../components/demos/*.ts');
  function mountIn(tile: Element) {
    const root = tile.querySelector<HTMLElement>('[data-demo]:not([data-mounted])');
    const load = root && loaders[`../../components/demos/${root.dataset.demo}.ts`];
    if (!root || !load) return;
    root.dataset.mounted = '';
    load().then((m) => m.mount(root));
  }
  document.addEventListener('xtile:open', (e) => mountIn(e.target as Element));
  // a #deep-link may have opened a tile before this script ran
  document.querySelectorAll('.xtile[data-open]').forEach(mountIn);
</script>

<style>
  .empty { padding-block: var(--s5); gap: var(--s3); }
  .empty__slots { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s1); }
  .empty__slots span { display: flex; gap: 10px; align-items: center; padding: var(--s2); border: 1px dashed var(--line-strong); border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-mute); }
  .empty__slots i { width: 8px; height: 8px; border-radius: 50%; background: var(--ink-mute); animation: sleep 2.4s ease-in-out infinite; }
  .empty__slots span:nth-child(2) i { animation-delay: .6s; } .empty__slots span:nth-child(3) i { animation-delay: 1.2s; } .empty__slots span:nth-child(4) i { animation-delay: 1.8s; }
  @keyframes sleep { 50% { background: var(--violet); box-shadow: 0 0 12px var(--violet); } }
  .empty__text { max-width: 60ch; font-size: var(--step-1); font-weight: 300; font-style: italic; color: var(--pearl); }
</style>
