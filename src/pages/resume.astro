---
/** HTML résumé. "Save as PDF" uses the browser's print dialog (print CSS below). Phone number intentionally omitted. */
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
import { getWork, getProfile, fmtMonth, certLine } from '../lib/content';
// Experience comes from src/content/work/, the rest from src/content/profile/.
const work = await getWork();
const education = await getProfile('education');
const skills = await getProfile('skills');
const certificates = await getProfile('certificates');
const publications = await getProfile('publications');
---
<Base title="Résumé" description={`Résumé of ${SITE.name}.`}>
  <article class="cv">
    <header class="cv__head">
      <div>
        <h1>{SITE.name}</h1>
        <p class="kicker">{SITE.resume.headline} · {SITE.location}</p>
      </div>
      <button type="button" class="btn-ghost no-print" onclick="window.print()">Save as PDF ↓</button>
    </header>
    <p class="cv__links mono">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {SITE.links.filter((l) => !['mail', 'rss'].includes(l.icon)).map((l) => <a href={l.href}>{l.href.replace(/^https?:\/\/(www\.)?/, '')}</a>)}
    </p>
    <p class="cv__about">{SITE.resume.summary}</p>

    <h2>Experience</h2>
    {work.map((w) => (
      <section class="cv__job">
        <div class="cv__row"><h3>{w.data.role} · {w.data.org}</h3><span class="kicker">{fmtMonth(w.data.start)} – {w.data.end ? fmtMonth(w.data.end) : 'now'}</span></div>
        <p>{w.data.summary}</p>
      </section>
    ))}

    {education.data.items.length > 0 && <h2>Education</h2>}
    {education.data.items.map((e) => (
      <section class="cv__job">
        <div class="cv__row"><h3>{e.degree} · {e.school}</h3><span class="kicker">{e.start} – {e.end ?? 'now'}</span></div>
        {e.courses.length > 0 && <p>{e.courses.map((c) => `${c.name} (${c.grade})`).join(', ')}.</p>}
      </section>
    ))}

    {skills.data.full.length > 0 && (
      <>
        <h2>Tools</h2>
        <dl class="cv__tools">
          {skills.data.full.map(({ group, items }) => <><dt>{group}</dt><dd>{items.join(', ')}</dd></>)}
        </dl>
      </>
    )}

    {certificates.data.items.length > 0 && (
      <>
        <h2>Certificates</h2>
        <p>{certificates.data.items.map(certLine).join(' · ')}.</p>
      </>
    )}

    {publications.data.items.length > 0 && (
      <>
        <h2>Publications</h2>
        {publications.data.items.map((p) => (
          <p>{p.kind} of {p.url ? <a href={p.url}><em>{p.title}</em></a> : <em>{p.title}</em>}{p.note && `, ${p.note}`}.</p>
        ))}
      </>
    )}
  </article>
</Base>

<style>
  .cv { max-width: 860px; margin: var(--s4) auto 0; padding: var(--s4) var(--s3); border-radius: var(--radius); background: var(--glass-strong); backdrop-filter: blur(16px); box-shadow: inset 0 0 0 1px var(--line); display: grid; gap: var(--s1); }
  .cv__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s2); }
  .cv h1 { font-size: var(--step-3); }
  .cv h2 { font-size: var(--step-1); margin-top: var(--s3); color: var(--starlight); font-style: italic; }
  .cv h3 { font-size: 1.05rem; font-family: var(--font-body); font-weight: 600; }
  .cv__row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; align-items: baseline; }
  .cv__links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.85rem; }
  .cv__about { font-style: italic; color: var(--ink-soft); }
  .cv__job { display: grid; gap: 4px; margin-top: var(--s1); }
  .cv__job p, .cv p { color: var(--ink-soft); font-size: 0.98rem; }
  .cv__tools { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; font-size: 0.95rem; }
  .cv__tools dt { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-mute); padding-top: 2px; }
  .cv__tools dd { margin: 0; color: var(--ink-soft); }
  @media print {
    :global(.sky), :global(.floaters), :global(.nav), :global(.shore), :global(.hire-dialog), .no-print { display: none !important; }
    :global(body), :global(html) { background: #fff !important; color: #111 !important; }
    .cv { box-shadow: none; background: #fff; backdrop-filter: none; margin: 0; padding: 0; max-width: none; }
    .cv * { color: #111 !important; }
    .cv a { text-decoration: none; }
  }
</style>
