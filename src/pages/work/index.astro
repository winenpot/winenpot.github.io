---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Timeline from '../../components/Timeline.astro';
import ExpandGrid from '../../components/ExpandGrid.astro';
import ExpandTile from '../../components/ExpandTile.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getWork, fmtMonth, countWord, topTags } from '../../lib/content';
import { t } from '../../i18n/ui';
const work = await getWork();
const cases = await Promise.all(work.map(async (w) => ({ w, Content: (await render(w)).Content })));
const tones = ['lavender', 'periwinkle', 'mauve', 'violet', 'starlight', 'cobalt'] as const;
---
<Base title="Work" description="Case studies: LLM systems, MLOps, forecasting and product engineering.">
  <header class="page-head">
    <p class="kicker">case studies · {work.length}</p>
    <h1><span class="wave-underline">Work</span></h1>
    <p>{countWord(work.length, 'role')}, one thread: using math to make software that decides well.</p>
  </header>
  <div class="bento timeline-row">
    <Card tone="periwinkle" span="m6 l12" label="the wave so far"><Timeline items={work} /></Card>
  </div>
  <TagFilter tags={topTags(work.map((w) => w.data.tags), { min: 2, max: 10 })} target=".xtile" />
  <ExpandGrid>
    {cases.map(({ w, Content }, i) => (
      <ExpandTile
        id={w.id}
        title={w.data.title}
        tone={w.data.tone ?? tones[i % tones.length]}
        label={w.data.org}
        wide={w.data.featured}
        backLabel={t('work.back')}
        tags={w.data.tags}
      >
        <Fragment slot="face">
          <p class="kicker">{w.data.role} · {fmtMonth(w.data.start)} – {w.data.end ? fmtMonth(w.data.end) : 'now'}</p>
          <p class="xtile__clamp muted">{w.data.summary}</p>
          {w.data.metrics.length > 0 && (
            <dl class="metrics xtile__bottom">
              {w.data.metrics.map((m) => <div><dd>{m.value}</dd><dt>{m.label}</dt></div>)}
            </dl>
          )}
        </Fragment>
        <div class="prose case__body"><Content /></div>
        {w.data.tags.length > 0 && <ul class="chips" role="list">{w.data.tags.map((x) => <li class="chip">{x}</li>)}</ul>}
      </ExpandTile>
    ))}
  </ExpandGrid>
</Base>

<style>
  .timeline-row { margin-bottom: var(--gap); }
  .metrics { display: flex; flex-wrap: wrap; gap: var(--s2); padding-top: var(--s1); margin: 0; }
  .metrics div { display: grid; gap: 2px; }
  .metrics dd { margin: 0; font-family: var(--font-mono); font-size: 1.5rem; color: var(--starlight); }
  .metrics dt { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-mute); max-width: 18ch; }
  .case__body { padding-top: var(--s1); border-top: 1px dashed var(--line); }
</style>
