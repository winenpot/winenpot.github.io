---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getWriting, fmtDate, readingTime, topTags } from '../../lib/content';
import { t } from '../../i18n/ui';
const posts = await getWriting();
---
<Base title="Writing" description="Essays on machine learning, mathematics, systems and philosophy.">
  <header class="page-head">
    <p class="kicker">essays · {posts.length}</p>
    <h1><span class="wave-underline">Writing</span></h1>
    <p>Long-form notes on machine learning, mathematics, systems and the occasional philosophical detour.</p>
  </header>
  <TagFilter tags={topTags(posts.map((p) => p.data.tags))} target=".post" />
  <div class="bento posts">
    {posts.map((p, i) => (
      <Card tone={(['lavender', 'periwinkle', 'mauve', 'violet'] as const)[i % 4]} span={i === 0 ? 'm6 l8' : 'm3 l4'} href={`/writing/${p.id}/`} class="post" data-tags={p.data.tags.join('|')}>
        <div class="post__inner">
          <p class="kicker">{fmtDate(p.data.date)} · {readingTime(p.body)} {t('post.minutes')}</p>
          <h2>{p.data.title}</h2>
          <p class="muted">{p.data.description}</p>
          {p.data.sample && <span class="sample-banner">sample</span>}
        </div>
      </Card>
    ))}
  </div>
</Base>

<style>
  .post h2 { font-size: var(--step-2); }
  .post__inner { display: grid; gap: var(--s1); }
</style>
